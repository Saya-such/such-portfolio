---
import basePath from "@/libs/basePath";
import { getCollection } from "astro:content";
const posts = (await getCollection("works")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

{
  posts.map((post) => (
    <li class="works-item pb-7 md:pb-12 xl:pb-16 2xl:pb-20">
      <a
        href={basePath(`/works/${post.id}`)}
        class="group/article text-main block"
      >
        <img
          src={basePath(post.data.thumbnail)}
          alt={post.data.title + " | suchの実績"}
          class="aspect-video h-full w-full object-cover drop-shadow-md transition duration-300 group-hover/article:opacity-95 group-hover/article:drop-shadow-xl"
        />
        <p class="font-en px-2 pt-3 pb-1.5 text-lg transition duration-300 group-hover/article:opacity-70 md:pt-6 md:pb-4 md:text-3xl md:tracking-widest lg:pt-7 lg:pb-5 2xl:pt-10 2xl:pb-7">
          {post.data.title}
        </p>
        <ul class="tags-list flex flex-wrap gap-2 px-2 pt-1 pb-12 duration-300 group-hover/article:opacity-70 md:pb-20 lg:pb-30">
          {post.data.tags.map((tag) => (
            <li class="font-en bg-main p-1 text-xs leading-none text-white md:px-2 md:py-1.5 md:text-base">
              {tag}
            </li>
          ))}
        </ul>
      </a>
    </li>
  ))
}
